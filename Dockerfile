FROM public.ecr.aws/docker/library/node:22-bookworm-slim AS build
ARG NPM_REGISTRY=https://registry.npmjs.org
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm config set registry $NPM_REGISTRY \
 && pnpm config set network-concurrency 4 \
 && pnpm config set fetch-retries 10 \
 && pnpm config set fetch-timeout 600000 \
 && pnpm install --frozen-lockfile --trust-lockfile

COPY . .

ARG NEXT_PUBLIC_SERVER_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_IMAGE_UNOPTIMIZED
ARG NEXT_PUBLIC_FIREBASE_API_KEY1
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN1
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID1
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET1
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID1
ARG NEXT_PUBLIC_FIREBASE_APP_ID1
ARG NEXT_PUBLIC_PUSHER_KEY
ARG NEXT_PUBLIC_PUSHER_CLUSTER
ARG NEXT_PUBLIC_PUSHER_APP_KEY
ARG NEXT_PUBLIC_PUSHER_APP_CLUSTER
ARG NEXT_PUBLIC_FIREBASE_DATABASE_URL
ARG NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID1
ARG NEXT_PUBLIC_MONETBIL_KEY
ARG NEXT_PUBLIC_AWS_REGION
ARG NEXT_PUBLIC_AWS_BUCKET_NAME
ARG NEXT_PUBLIC_AWS_SECRET_NAME
ARG NEXT_PUBLIC_AWS_SECRET_REGION
ENV NEXT_PUBLIC_SERVER_URL=$NEXT_PUBLIC_SERVER_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_IMAGE_UNOPTIMIZED=$NEXT_PUBLIC_IMAGE_UNOPTIMIZED
ENV NEXT_PUBLIC_FIREBASE_API_KEY1=$NEXT_PUBLIC_FIREBASE_API_KEY1
ENV NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN1=$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN1
ENV NEXT_PUBLIC_FIREBASE_PROJECT_ID1=$NEXT_PUBLIC_FIREBASE_PROJECT_ID1
ENV NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET1=$NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET1
ENV NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID1=$NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID1
ENV NEXT_PUBLIC_FIREBASE_APP_ID1=$NEXT_PUBLIC_FIREBASE_APP_ID1
ENV NEXT_PUBLIC_PUSHER_KEY=$NEXT_PUBLIC_PUSHER_KEY
ENV NEXT_PUBLIC_PUSHER_CLUSTER=$NEXT_PUBLIC_PUSHER_CLUSTER
ENV NEXT_PUBLIC_PUSHER_APP_KEY=$NEXT_PUBLIC_PUSHER_APP_KEY
ENV NEXT_PUBLIC_PUSHER_APP_CLUSTER=$NEXT_PUBLIC_PUSHER_APP_CLUSTER
ENV NEXT_PUBLIC_FIREBASE_DATABASE_URL=$NEXT_PUBLIC_FIREBASE_DATABASE_URL
ENV NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID1=$NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID1
ENV NEXT_PUBLIC_MONETBIL_KEY=$NEXT_PUBLIC_MONETBIL_KEY
ENV NEXT_PUBLIC_AWS_REGION=$NEXT_PUBLIC_AWS_REGION
ENV NEXT_PUBLIC_AWS_BUCKET_NAME=$NEXT_PUBLIC_AWS_BUCKET_NAME
ENV NEXT_PUBLIC_AWS_SECRET_NAME=$NEXT_PUBLIC_AWS_SECRET_NAME
ENV NEXT_PUBLIC_AWS_SECRET_REGION=$NEXT_PUBLIC_AWS_SECRET_REGION

RUN pnpm build

FROM public.ecr.aws/docker/library/node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=build /app/public ./public
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static

EXPOSE 3000
CMD ["node", "server.js"]